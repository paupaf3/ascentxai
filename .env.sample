GITHUB_TOKEN=your_token_here
# Api key from Nvidia only works for 12 months
NIM_API_KEY=your_nvidia_api_key_here 

# Optional model overrides
# Defaults: extraction → meta/llama-3.1-8b-instruct, analysis → nvidia/llama-3.3-nemotron-super-49b-v1
# Check available models at https://build.nvidia.com (enable "Free Endpoint" filter)
# EXTRACTION_MODEL=meta/llama-3.1-8b-instruct
# ANALYSIS_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
