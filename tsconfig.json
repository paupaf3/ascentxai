{
    "compilerOptions": {
        // File layout
        "rootDir": ".",
        "outDir": "./dist",

        // Environment
        "target": "ES2022",
        "module": "CommonJS",
        "lib": ["ES2022"],
        "types": ["node", "vitest/globals"],

        // Module resolution
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,

        // Source maps
        "sourceMap": true,

        // Strict type checking
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true
    },
    "include": ["src/**/*", "tests/**/*", "scripts/**/*"],
    "exclude": ["node_modules", "dist"]
}
